-- ============================================================
-- CLEANING SCRIPT FOR SILVER LAYER: CUSTOMER DATA TRANSFORMATION
-- Source: bronze.crm_cust_info
-- Target: silver.crm_cust_info
-- Purpose: Deduplicate and standardize customer records



--this page is for the crm customer info table, this takes the data from bronze.crm_cust_info
--and performs adjustments to help clean the incoming info. 
--I have labeled each transformation with a t# in terms of order I did for clarification
-- ============================================================
print '>> Truncating Table: silver.crm_cust_info';
truncate table silver.crm_cust_info;
print 'Inserting Data Into: silver.crm_cust_info';

Insert into silver.crm_cust_info (

cst_id,
cst_key,
cst_firstname,
cst_lastname,
cst_material_status,
cst_gndr,
cst_create_date

)

--transformations starting with t1 and building out, after T2 I just listed out a select to all colomns 
--and did the transformations, using the transformed t2 table to pull from. 

--
SELECT
cst_id,
cst_key,

-- T3: Remove whitespace before and after customer names
trim(cst_firstname) as cst_firstname,
trim(cst_lastname) as cst_lastname,

-- T4: Standardize marital status into something understandable
-- Trimed whitespace and accounted for lowercase, map unknown values to n/a
--cst_material_status,
CASE when UPPER(trim(cst_material_status)) = 'S' then 'Single'
     when Upper(trim(cst_material_status)) = 'M' then 'Married'
     else 'n/a'
end cst_material_status,

-- T4: Standardize gender into male or female
-- Trimed whitespace and accounted for lowercase, map unknown values to n/a
--cst_gndr, 
CASE when UPPER(trim(cst_gndr)) = 'F' then 'Female'
     when Upper(trim(cst_gndr)) = 'M' then 'Male'
     else 'n/a'
end cst_gndr,
cst_create_date

from(
    -- T2: remove duplicate curstomer records
    -- retain only the most recent record as per the date for each customer id
    select
    *
    from

        -- T1: Rank customer records with a window function 
        -- Partition by customer ID and assign rank 1 to the newest record
        (select  
        *,
        row_number() over (partition by cst_id order by cst_create_date desc) as pick_last
        from bronze.crm_cust_info) t1 
        where pick_last = 1

    ) t2;




